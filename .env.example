# Copy to .env.local and fill in. Everything here is OPTIONAL —
# `npm run recover:batch` runs fully offline with no keys.

# ---- LLM (provider-agnostic; default = Google Gemini) ----
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override the model (default: gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-pro
#
# ...or use ANY provider via the Vercel AI Gateway instead of a direct key:
# AI_GATEWAY_API_KEY=
# LLM_MODEL=openai/gpt-4o            # or anthropic/claude-…, google/gemini-2.5-flash
#
# Turn the LLM ON inside the batch (default OFF = deterministic offline heuristic,
# which keeps the headline metrics reproducible and free):
# LLM=1

# ---- Razorpay TEST MODE (for the live executor + dashboard demo) ----
# Dashboard → switch to Test Mode → Settings → API Keys → Generate
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ---- Batch controls ----
# SEED=42
# N=120
