# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# recoup generated artifacts (reproducible via `npm run recover:batch`)
/artifacts

# playwright-cli scratch (snapshots, console logs)
/.playwright-cli

# shadcn MCP config (local dev tool, not part of the product)
/.mcp.json

# personal interview prep — not part of the project
/docs/PANEL_PREP.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
